---
import { Icon } from "astro-icon/components";
import { localizePath } from "astro-i18next";
import { getBannerIncidents } from "../lib/statuspage";

const { isMain, variant = "top" } = Astro.props;

const bannerIncidents = await getBannerIncidents(localizePath("/services.json"));

const affectedIcons = [...new Set(bannerIncidents.map(inc => inc.serviceIcon).filter(Boolean))];

const hasActiveIncidents = bannerIncidents.length > 0;
const showTop = variant === "top" && !isMain && hasActiveIncidents;
const showNavbar = variant === "navbar" && !!isMain && hasActiveIncidents;
const navbarColor = bannerIncidents[0]?.serviceColor ?? "#e74c3c";
---

{showTop && (
  <div id="incident-banner" class="incident-banner">
    <div class="incident-banner-inner">
      <div class="banner-slides">
        {bannerIncidents.map((inc, i) => (
          <div class={`banner-slide ${i === 0 ? 'active' : ''}`} data-color={inc.serviceColor} style={`background-color: ${inc.serviceColor};`}>
            <div class="banner-slide-content">
              <div class="banner-service-info">
                {inc.serviceIcon && (
                  <img src={`/img/${inc.serviceIcon}`} alt={inc.serviceName} class="banner-service-icon" />
                )}
                <span class="banner-service-name"><b>{inc.serviceName}</b></span>
              </div>
              <span class="banner-separator" aria-hidden="true">-</span>
              <a href={inc.shortlink} target="_blank" rel="noopener noreferrer" class="banner-incident-title text-decoration-none">
                {inc.incidentName}
              </a>
            </div>
          </div>
        ))}
      </div>
      <button class="banner-close" aria-label="Close banner">
        <Icon name="lucide:x" style="width:18px; height:18px;" />
      </button>
    </div>
    {bannerIncidents.length > 1 && (
      <div class="banner-pagination" role="group" aria-label="Incident slides">
        {bannerIncidents.map((inc, i) => (
          <button
            type="button"
            class={`banner-dot ${i === 0 ? 'active' : ''}`}
            data-index={i}
            aria-label={`Show ${inc.serviceName} incident: ${inc.incidentName}`}
            aria-current={i === 0 ? 'true' : 'false'}
          ></button>
        ))}
      </div>
    )}
  </div>
)}

<style>
  .incident-banner {
    --banner-duration: 4s;
    width: 100%;
    z-index: 10001;
    position: relative;
    overflow: hidden;
    background-color: #e74c3c;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.12);
    transition: background-color 0.5s ease, transform 0.35s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.35s ease;
  }

  .incident-banner.hidden {
    transform: translateY(-100%);
    opacity: 0;
    pointer-events: none;
    height: 0;
    overflow: hidden;
  }

  .incident-banner-inner {
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    font-family: inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }

  .banner-pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 0 20px 10px;
    position: absolute;
    bottom: 0;
    z-index: 2;
  }

  .banner-dot {
    appearance: none;
    -webkit-appearance: none;
    width: 4px;
    height: 4px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.35);
    cursor: pointer;
    position: relative;
    overflow: hidden;
    flex: 0 0 auto;
    transition: width 0.4s cubic-bezier(0.4, 0, 0.2, 1), background-color 0.25s ease, transform 0.25s ease;
  }

  .banner-dot::after {
    content: "";
    position: absolute;
    inset: 0;
    width: 0;
    border-radius: inherit;
    background: white;
  }

  .banner-dot.active {
    width: 36px;
    background: rgba(255, 255, 255, 0.3);
  }

  .banner-dot.active::after {
    width: 100%;
    animation: banner-fill var(--banner-duration) linear forwards;
  }

  .banner-dot:not(.active):hover {
    background: rgba(255, 255, 255, 0.65);
    transform: scale(1.15);
  }

  @keyframes banner-fill {
    from { width: 0; }
    to { width: 100%; }
  }

  .incident-banner:hover .banner-dot.active::after,
  .incident-banner.hidden .banner-dot.active::after {
    animation-play-state: paused;
  }

  .banner-slides {
    flex: 1;
    position: relative;
    overflow: hidden;
    min-height: 48px;
  }

  .banner-slide {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transform: translateY(10px) scale(0.99);
    transition: opacity 0.45s ease, transform 0.45s cubic-bezier(0.4, 0, 0.2, 1);
    pointer-events: none;
    background-image: linear-gradient(180deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0));
  }

  .banner-slide.active {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
    position: relative;
    z-index: 1;
  }

  .banner-slide.exit {
    opacity: 0;
    transform: translateY(-10px) scale(0.99);
  }

  .banner-slide-content {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 12px 52px;
    color: white;
    flex-wrap: wrap;
    justify-content: center;
  }

  .banner-service-info {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  .banner-service-icon {
    width: 28px;
    height: 28px;
    object-fit: contain;
    filter: brightness(10000%) drop-shadow(0 1px 2px rgba(0, 0, 0, 0.2));
  }

  .banner-service-name {
    font-weight: 700;
    font-size: 14px;
    white-space: nowrap;
  }

  .banner-separator {
    opacity: 0.55;
    padding: 0 2px;
  }

  .banner-incident-title {
    color: white;
    text-decoration: underline;
    text-underline-offset: 3px;
    font-size: 14px;
    font-weight: 500;
    transition: opacity 0.2s ease;
  }

  .banner-incident-title:hover {
    opacity: 0.8;
  }

  .banner-close {
    position: absolute;
    right: 6px;
    top: 50%;
    transform: translateY(-50%);
    width: 30px;
    height: 30px;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.12);
    color: white;
    cursor: pointer;
    opacity: 0.8;
    transition: background-color 0.2s ease, opacity 0.2s ease, transform 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 3;
    flex-shrink: 0;
  }

  .banner-close:hover {
    opacity: 1;
    background: rgba(255, 255, 255, 0.22);
    transform: translateY(-50%) scale(1.05);
  }

  @media (prefers-reduced-motion: reduce) {
    .incident-banner,
    .banner-dot,
    .banner-slide,
    .banner-close {
      transition: none;
    }

    .banner-slide {
      transform: none;
    }

    .banner-dot.active::after {
      animation: none;
      width: 100%;
    }
  }

  .navbar-incident {
    margin-left: 6px;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: 8px;
    color: white;
    text-decoration: none;
    transition: 0.2s;
    flex-shrink: 0;
  }

  .navbar-incident:hover {
    transform: scale(1.05);
  }

  .navbar-incident-icon {
    width: 20px;
    height: 20px;
    object-fit: contain;
    filter: brightness(10000%);
  }
</style>

<script is:inline>
  function initIncidentBanner() {
    const banner = document.getElementById('incident-banner');
    if (!banner) return;

    const slides = banner.querySelectorAll('.banner-slide');
    const dots = banner.querySelectorAll('.banner-dot');
    const closeBtn = banner.querySelector('.banner-close');
    const COOKIE_NAME = 'incident-banner-closed';
    const COOKIE_DAYS = 3;
    let currentIndex = 0;

    function showSlide(index) {
      const previous = currentIndex;
      currentIndex = index;

      slides.forEach((slide, i) => {
        slide.classList.toggle('active', i === index);
        slide.classList.toggle('exit', i === previous && previous !== index);
        slide.setAttribute('aria-hidden', i === index ? 'false' : 'true');
      });

      if (index !== previous) {
        dots.forEach(function(dot) { dot.classList.remove('active'); });
      }

      const activeDot = dots[index];
      if (activeDot && !activeDot.classList.contains('active')) {
        void activeDot.offsetWidth;
        activeDot.classList.add('active');
      }

      dots.forEach(function(dot, i) {
        dot.setAttribute('aria-current', i === index ? 'true' : 'false');
      });

      banner.style.backgroundColor = slides[index]?.dataset.color || '#e74c3c';
    }

    function nextSlide() {
      if (slides.length > 1) showSlide((currentIndex + 1) % slides.length);
    }

    function setClosedCookie() {
      const d = new Date();
      d.setTime(d.getTime() + COOKIE_DAYS * 24 * 60 * 60 * 1000);
      document.cookie = COOKIE_NAME + '=true; expires=' + d.toUTCString() + '; path=/; SameSite=Lax';
    }

    function hasClosedCookie() {
      return document.cookie.split('; ').some(function(c) {
        return c === COOKIE_NAME + '=true';
      });
    }

    function closeBanner() {
      banner.classList.add('hidden');
      setClosedCookie();
    }

    if (closeBtn) {
      closeBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        closeBanner();
      });
    }

    dots.forEach(function(dot) {
      dot.addEventListener('click', function(e) {
        e.stopPropagation();
        showSlide(Number(dot.dataset.index));
      });

      dot.addEventListener('animationend', function() {
        if (!dot.classList.contains('active')) return;
        if (banner.classList.contains('hidden')) return;
        nextSlide();
      });
    });

    if (hasClosedCookie()) {
      banner.classList.add('hidden');
    } else {
      showSlide(0);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initIncidentBanner);
  } else {
    initIncidentBanner();
  }
</script>
