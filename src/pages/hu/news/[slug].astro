---
import { contentfulClient } from "../../../lib/contentful";
import { documentToHtmlString } from "@contentful/rich-text-html-renderer";
import { documentToPlainTextString } from "@contentful/rich-text-plain-text-renderer";
import type { news } from "../../../lib/contentful";
import Layout from "../../../layouts/Layout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import News from "../../../components/News.astro";
import i18next, { t, changeLanguage } from "i18next";
import { extractTranscriptParticipantsFromHtml } from "../../../lib/transcript";

changeLanguage("hu");

export async function getStaticPaths() {
    const { items } = await contentfulClient.getEntries<news>({
        content_type: "newsPost"
    });
    return items.map(item => ({
        params: { slug: item.fields.slug },
        props: {
            title: item.fields.title,
            slug: item.fields.slug,
            content: item.fields.content,
            date: item.fields.date,
            image: item.fields.image,
            unlist: item.fields.unlist,
            description: item.fields.description,
            author: item.fields.author,
            isAnnouncement: item.fields.isAnnouncement
        }
    }));
}
type NewsPostPageProps = {
    content: any;
    title: string;
    slug: string;
    date: string;
    image: any;
    unlist: boolean;
    description: string;
    author: any;
    isAnnouncement: boolean;
};
const props = Astro.props as unknown as NewsPostPageProps;
const { content, title, slug, date, image, unlist, description, author, isAnnouncement } = props;
const titleText = String(title);
const articleDate = new Date(String(date));
// Contentful rich-text -> HTML rendering (embedded assets)
const UNSUPPORTED_ASSET_HTML = `<p class="flex flex-row items-center gap-3 font-[MGNHumble]"><svg fill="none" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-10 h-10"> <path d="M3 3h16v2H5v14h14v2H3V3zm18 0h-2v18h2V3zM11 15h2v2h-2v-2zm2-8h-2v6h2V7z" fill="currentColor"/> </svg> Unsupported asset type</p>`;
function renderFileLink(url: string, title: string): string {
    return `<a href="${url}" target="_blank" class="pixel-corners mb-3 border border-white/20 bg-white/5 hover:bg-white/10 hover:text-white text-white flex flex-col items-center justify-between relative"><p class="p-3 w-full flex flex-row items-center justify-between relative" style="margin-bottom:0;"><span class="flex flex-row items-center gap-3"><svg class="w-6 relative" fill="none" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"> <path d="M21 22H3V2h12v2h2v2h2v2h2v14zM17 6h-2v2h2V6zM5 4v16h14V10h-6V4H5zm8 12H7v2h6v-2zm-6-4h10v2H7v-2zm4-4H7v2h4V8z" fill="currentColor"/> </svg> ${title}</span> <svg class="w-6" fill="none" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"> <path d="M4 11v2h12v2h2v-2h2v-2h-2V9h-2v2H4zm10-4h2v2h-2V7zm0 0h-2V5h2v2zm0 10h2v-2h-2v2zm0 0h-2v2h2v-2z" fill="currentColor"/> </svg></p></a>`;
}
const options = {
    renderNode: {
        "embedded-asset-block": (node: any) => {
            const file = node.data.target.fields?.file;
            if (!file || !file.contentType) {
                return UNSUPPORTED_ASSET_HTML;
            }
            const { contentType: mimeType, url } = file;
            const assetTitle = node.data.target.fields.title ?? "";
            if (mimeType.startsWith("image/")) {
                return `<img style="width:100%; height: auto; border-radius: 8px;" src="${url}" alt="${assetTitle}"/>`;
            }
            if (mimeType.startsWith("video/")) {
                return `<video style="width:100%; border-radius:8px;" autoplay loop muted>
                            <source src="${url}" type="${mimeType}">
                            Your browser does not support the video tag.
                        </video>`;
            }
            if (mimeType === "application/pdf") {
                return `<embed src="${url}" type="application/pdf" width="100%" height="600px" />`;
            }
            return renderFileLink(url, assetTitle);
        }
    }
};
let parsedSEOContent = documentToPlainTextString(content as any);
if (parsedSEOContent.length > 160) {
    parsedSEOContent = parsedSEOContent.slice(0, 160) + "...";
}
let bodyHTML = content ? documentToHtmlString(content as any, options) : "";
function extractStyle(attrs: string): string {
    const match = attrs.match(/style=&quot;(.*?)&quot;/);
    return match ? match[1] : "";
}
function replaceTagBlocks(html: string, tagName: string, render: (attrs: string, inner: string) => string): string {
    const pattern = new RegExp(`<p>&lt;${tagName}(?=[\\s&])([^&]*?)&gt;</p>([\\s\\S]*?)<p>&lt;end-${tagName}&gt;</p>`, "g");
    return html.replace(pattern, (_full, attrs: string, inner: string) => render(attrs, inner.trim()));
}
function renderFloatChild(side: "left" | "right") {
    return (attrs: string, inner: string) => `<div class="float float-${side}" style="${extractStyle(attrs)}">${inner}</div>`;
}
function parseFloatTags(html: string): string {
    html = replaceTagBlocks(html, "embed", (attrs, inner) => {
        const style = extractStyle(attrs);
        const src = inner.replace(/<\/?p>/g, "");
        return `<iframe style="width:100%; height:100%; border-radius: 8px; aspect-ratio:16/9; ${style}" title="Embed Content" src="${src}"></iframe>`;
    });
    html = replaceTagBlocks(html, "float", (attrs, inner) => {
        const style = extractStyle(attrs);
        let innerContent = replaceTagBlocks(inner, "float-left", renderFloatChild("left"));
        innerContent = replaceTagBlocks(innerContent, "float-right", renderFloatChild("right"));
        return `<div class="float-container" style="${style} display:flex; justify-content:space-between;">${innerContent}</div>`;
    });
    return html;
}
function parseCenterTags(html: string): string {
    return html.replace(/<p>&lt;center&gt;<\/p>([\s\S]*?)<p>&lt;end-center&gt;<\/p>/g, (_full, inner) => `<div class="center">${inner}</div>`);
}
function parseLocalizedContent(html: string): Array<{
    lang: string;
    content: string;
}> {
    const regex = /<p>&lt;begin-localization=&quot;(.*?)&quot;&gt;<\/p>([\s\S]*?)<p>&lt;end-localization=&quot;\1&quot;&gt;<\/p>/g;
    return [...html.matchAll(regex)].map(match => ({
        lang: match[1],
        content: match[2].trim()
    }));
}
// HTML escaping / entity decoding
function escapeHtml(text: string): string {
    return text
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#39;");
}
function stripHtmlTags(text: string): string {
    return text.replace(/<[^>]+>/g, "");
}
function decodeHtmlEntities(text: string): string {
    return text
        .replace(/&nbsp;/g, " ")
        .replace(/&quot;/g, "\"")
        .replace(/&#39;/g, "'")
        .replace(/&lt;/g, "<")
        .replace(/&gt;/g, ">")
        .replace(/&amp;/g, "&");
}
// ---------------------------------------------------------------------------
// Chat transcript parsing
//
// Format:
//   Speaker: alias-alias2 - Display Name (avatar-url)
//   Interviewee: alias - Display Name (avatar-url)
//   ---
//   alias: message text (action)
// ---------------------------------------------------------------------------
type ChatRole = "speaker" | "interviewee";
type ChatParticipant = {
    role: ChatRole;
    name: string;
    avatar: string;
};
function parseChatHeaderLine(line: string): (ChatParticipant & {
    aliases: string[];
}) | null {
    const match = line.match(/^(Speaker|Interviewee):\s*([A-Za-z0-9]+(?:-[A-Za-z0-9]+)*)\s*-\s*(.+?)\s*\((.*?)\)\s*$/i);
    if (!match)
        return null;
    return {
        role: match[1].toLowerCase() === "speaker" ? "speaker" : "interviewee",
        aliases: match[2].split("-").map(alias => alias.trim()).filter(Boolean),
        name: match[3].trim(),
        avatar: match[4].trim()
    };
}
function parseChatBlock(blockHtml: string): {
    aliases: string[];
    messageHtml: string;
} | null {
    const innerHtml = blockHtml.replace(/^<p[^>]*>/i, "").replace(/<\/p>$/i, "");
    const match = innerHtml.match(/^([A-Za-z0-9]+(?:-[A-Za-z0-9]+)*)\s*:\s*([\s\S]*)$/);
    if (!match)
        return null;
    return {
        aliases: match[1].split("-").map(alias => alias.trim()).filter(Boolean),
        messageHtml: match[2].trim()
    };
}
function splitChatBlocks(html: string): string[] {
    const blockRegex = /<(?:p|h[1-6]|blockquote|ul|ol|div|figure|table)(?:\s[^>]*)?>[\s\S]*?<\/(?:p|h[1-6]|blockquote|ul|ol|div|figure|table)>|<hr[^>]*>|<img[^>]*>/gi;
    return html.match(blockRegex) ?? [html];
}
const CHAT_ACTION_PATTERNS: Array<[
    RegExp,
    string
]> = [
    [/(laugh|giggle|smirk|chuckle)/, "laugh"],
    [/(think|ponder|hmm|huh|wonder|consider)/, "thought"],
    [/(smile|happy|grin|joy|excited|yay)/, "happy"],
    [/(sad|sigh|cry|tears|upset|down)/, "sad"],
    [/(angry|mad|annoyed|frustrated|grr|huff)/, "angry"]
];
function classifyChatAction(actionText: string): string {
    const normalized = actionText.toLowerCase();
    const found = CHAT_ACTION_PATTERNS.find(([pattern]) => pattern.test(normalized));
    return found ? found[1] : "neutral";
}
function renderChatMessageHtml(messageHtml: string): string {
    const parts: string[] = [];
    const actionRegex = /\(([^)]+)\)/g;
    let lastIndex = 0;
    let match: RegExpExecArray | null;
    while ((match = actionRegex.exec(messageHtml)) !== null) {
        if (match.index > lastIndex) {
            parts.push(messageHtml.slice(lastIndex, match.index));
        }
        const actionText = match[1].trim();
        parts.push(`<span class="chat-action chat-action--${classifyChatAction(actionText)}">${escapeHtml(`(${actionText})`)}</span>`);
        lastIndex = actionRegex.lastIndex;
    }
    if (lastIndex < messageHtml.length) {
        parts.push(messageHtml.slice(lastIndex));
    }
    return parts.join("").replace(/\n/g, "<br />");
}
function getFallbackAvatarColor(name: string): string {
    let hash = 0;
    for (const character of name) {
        hash = character.charCodeAt(0) + ((hash << 5) - hash);
    }
    const hue = Math.abs(hash) % 360;
    return `hsl(${hue} 65% 45%)`;
}
function renderChatBubble({ role, name, avatar, message }: {
    role: ChatRole;
    name: string;
    avatar: string;
    message: string;
}): string {
    const isSpeaker = role === "speaker";
    const initials = name
        .split(/\s+/)
        .filter(Boolean)
        .map(part => part[0])
        .join("")
        .slice(0, 2)
        .toUpperCase() || name.slice(0, 1).toUpperCase();
    const avatarMarkup = avatar
        ? `<img class="chat-avatar" src="${escapeHtml(avatar)}" alt="${escapeHtml(name)}" />`
        : `<div class="chat-avatar chat-avatar--fallback" aria-hidden="true" style="background:${getFallbackAvatarColor(name)}; color:white;">${escapeHtml(initials)}</div>`;
    return `<div class="chat-message ${isSpeaker ? "chat-message--speaker" : "chat-message--interviewee"}">
    ${isSpeaker ? "" : avatarMarkup}
    <div class="chat-bubble">
      <div class="chat-name">${escapeHtml(name)}</div>
      <div class="chat-text">${renderChatMessageHtml(message)}</div>
    </div>
    ${isSpeaker ? avatarMarkup : ""}
  </div>`;
}
function parseChatTranscript(html: string): string {
    const blocks = splitChatBlocks(html);
    if (blocks.length === 0)
        return html;
    const [firstBlock, ...remainingBlocks] = blocks;
    if (!firstBlock)
        return html;
    const firstBlockText = decodeHtmlEntities(firstBlock.replace(/^<p>|<\/p>$/g, "")).trim();
    const firstBlockLines = firstBlockText.split(/\r?\n/).map(line => line.trim()).filter(Boolean);
    if (!firstBlockLines.includes("---"))
        return html;
    const participants = new Map<string, ChatParticipant>();
    for (const line of firstBlockLines) {
        if (line === "---")
            continue;
        const parsed = parseChatHeaderLine(line);
        if (!parsed)
            continue;
        for (const alias of parsed.aliases) {
            participants.set(alias, { role: parsed.role, name: parsed.name, avatar: parsed.avatar });
        }
    }
    if (participants.size === 0)
        return html;
    const output: string[] = [];
    for (const block of remainingBlocks) {
        const messageBlock = parseChatBlock(block);
        if (!messageBlock) {
            output.push(block);
            continue;
        }
        const participant = messageBlock.aliases
            .map(alias => participants.get(alias))
            .find((item): item is ChatParticipant => Boolean(item));
        if (!participant) {
            output.push(block);
            continue;
        }
        const role = messageBlock.aliases.some(alias => participants.get(alias)?.role === "speaker")
            ? "speaker"
            : participant.role;
        output.push(renderChatBubble({
            role,
            name: participant.name,
            avatar: participant.avatar,
            message: messageBlock.messageHtml
        }));
    }
    return output.join("");
}
// Assemble final body HTML
const localizedContentArray = parseLocalizedContent(bodyHTML);
const currentLanguage = i18next.language;
const defaultLanguage = "en";
const localizedContent = localizedContentArray.find(item => item.lang === currentLanguage);
const defaultContent = localizedContentArray.find(item => item.lang === defaultLanguage);
bodyHTML = localizedContent?.content || defaultContent?.content || bodyHTML;
bodyHTML = parseFloatTags(bodyHTML);
bodyHTML = parseCenterTags(bodyHTML);
const transcriptParticipants = extractTranscriptParticipantsFromHtml(bodyHTML);
bodyHTML = parseChatTranscript(bodyHTML);
const updatedTagline = titleText
    .split(" ")
    .map((word, index) => `<span style="--delay: ${index * 0.2}s;">${word}</span>`)
    .join(" ");
// Strip tags before counting words, or attribute strings (class names, style
// rules, URLs) inflate the word count and skew the reading-time estimate.
const wordCount = stripHtmlTags(bodyHTML).trim().split(/\s+/).filter(Boolean).length;
const readingTime = Math.ceil(wordCount / 200);
---

<Layout
  title={`WiiLink - ${t("newsPost.name")} (${titleText})`}
  description={`${titleText} - ${description}`}
  image={`/img/news-og-img/${slug}.png`}
/>

<Header isGuide="display:none;" section={unlist ? "Forming Links" : t("header.news")} title={titleText} />
<div class="headtitle" style={`background-color:var(--bg-color-secondary); ${unlist ? "border-radius: 32px 32px 32px 10px;" : ""}`}>
  <div
    style="display:flex; flex-direction:row; gap:28px; flex-wrap:wrap; align-items:center; justify-content:center;">
    {
      (image as any)?.fields?.file?.url && (
        <>
          <img
            class="mainimg"
            src={
              (image as any)?.fields?.file?.url
                ? (image as any)?.fields?.file?.url
                : "/img/branding_bg.webp"
            }
            alt=""
            width="200px"
          />
          <img
            class="mainimg2"
            style="height:100%; filter:blur(80px) brightness(0.5); transform:scale(1.2);"
            src={
              (image as any)?.fields?.file?.url
                ? (image as any)?.fields?.file?.url
                : "/img/branding_bg.webp"
            }
            alt=""
            width="200px"
          />
        </>
      )
    }
    <div>
      <h2
        id="titleData"
        class="title"
        style={`color:  ${(image as any)?.fields?.file?.url ? "white !important" : "var(--color)"};`} set:html={updatedTagline} />
      </h2>
      <hr
        style={`border-top: 2px solid ${(image as any)?.fields?.file?.url ? "white" : "var(--color)"};`}
      />
      <div
        style="margin-top:18px; display:flex; flex-direction: row; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:28px;">
        <div class="mobileHeadAuth" style="display:flex; gap:4px;">
           {unlist && transcriptParticipants.length > 0 && (
          <div style="display:flex; flex-wrap:wrap; gap:10px; align-items:stretch;">
            {transcriptParticipants.map((participant) => (
              <div
                style={`display:flex; align-items:center; gap:10px; padding:10px 14px; border-radius:${participant.role === "speaker" ? "999px 999px 999px 300px" : "999px 999px 300px 999px"}; background:${participant.role === "speaker" ? "var(--bg-color-primary)" : "var(--bg-color-tertiary)"}; border:1px solid rgba(255, 255, 255, 0.08); box-shadow:0 10px 20px rgba(0, 0, 0, 0.12);`}>
                {participant.avatar ? (
                  <img
                    src={participant.avatar}
                    alt={participant.name}
                    style="width:44px; height:44px; border-radius:50%; object-fit:cover; border:2px solid rgba(255,255,255,0.14); flex:0 0 44px;"
                  />
                ) : (
                  <div
                    aria-hidden="true"
                    style={`width:44px; height:44px; border-radius:50%; display:flex; align-items:center; justify-content:center; flex:0 0 44px; background:${participant.color}; color:white; font-family:Gilroy; font-size:16px; border:2px solid rgba(255,255,255,0.14);`}>
                    {participant.initials}
                  </div>
                )}
                <div style="display:flex; flex-direction:column; line-height:1.1;">
                  <span style="font-family:Gilroy; font-size:16px; color:var(--color);">{participant.name}</span>
                </div>
              </div>
            ))}
          </div>
        )}
        { !unlist && (
          <r
            style={`background-color: ${(image as any)?.fields?.file?.url ? "#ffffff20" : "var(--bg-opaque-1)"}; color: ${(image as any)?.fields?.file?.url ? "white" : "var(--color)"} !important; padding:8px 20px; border-radius:8px 4px 4px 8px; font-family:system-ui; position:relative;`}
            datetime={articleDate.toISOString()}>
            {
              articleDate.toLocaleDateString("en-uk", {
                year: "numeric",
                month: "short",
                day: "numeric"
              })
            }
          </r>
          <r
            style={`background-color: ${(image as any)?.fields?.file?.url ? "#ffffff20" : "var(--bg-opaque-1)"}; color: ${(image as any)?.fields?.file?.url ? "white" : "var(--color)"} !important; padding:8px 20px; border-radius:4px 4px 4px 4px; font-family:system-ui; position:relative;`}
            >{(author as any).fields.name}</r
          >
          <r
            style={`background-color: ${(image as any)?.fields?.file?.url ? "#ffffff20" : "var(--bg-opaque-1)"}; color: ${(image as any)?.fields?.file?.url ? "white" : "var(--color)"} !important; padding:8px 20px; border-radius:4px 8px 8px 4px; font-family:system-ui; position:relative;`}
            >{(author as any).fields.role}</r
          >
                  )}
        </div>
        <div style="display:flex; flex-direction:row; align-items:center;">
          <r
            style={`font-family:system-ui; color:${(image as any)?.fields?.file?.url ? "white" : "var(--color)"} !important; position:relative;`}
          ><span class="clock"></span> {readingTime} min read</r>
        </div>
      </div>
    </div>
  </div>
</div>
{ isAnnouncement && 
  <div style="height:0; width: 95%; max-width: 1200px; background: linear-gradient(to right, #4c61af30, var(--bg-color-tertiary)); border-radius:8px; margin-bottom:8px; padding: 0px 20px; left:50%; transform:translate(-50%, 0%); interpolate-size: allow-keywords; animation: sizeup 1000ms 0.5s ease-in-out forwards; position:relative; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px; overflow:hidden;">
  <span>
  <h2 style="font-family:Gilroy; font-size: 32px;">Also available in WiiLink Announcements!</h2>
  <p style="font-family:system-ui; margin-bottom: 0px !important;">Get service updates right on your Wii Menu by subscribing to WiiLink Announcements.</br> Get it now by running the latest version of the WiiLink Mail Patcher!</p>
  </span>
  <span>
    <a href="/guide/board" style="text-decoration:none;">
      <button style="padding:10px 15px; border-radius:8px; border:none; background-color:#5a8630; color:#ffffff !important; font-family:system-ui; cursor:pointer; display: flex; align-items: center; gap: 6px;"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-mail-icon lucide-mail"><path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7"/><rect x="2" y="4" width="20" height="16" rx="2"/></svg> Get Mail Patcher</button>
    </a>
  </span>
</div>
}
<div class="article-holder" style=`${unlist ? "border-radius: 32px !important;" : ""}`}>
  <div class="postexpand" set:html={bodyHTML} />

  <div class="auths">
    {
      author?.fields?.pfp?.fields?.file?.url && (
        <img
          class="authimage mobilehide"
          width={50}
          height={50}
          src={author.fields.pfp.fields.file.url}
          alt={`Profile picture of ${author.fields.name}`}
        />
      )
    }
    <div class="titles">
      <div class="hold">
        {
          author?.fields?.pfp?.fields?.file?.url && (
            <img
              class="authimage mobileshow"
              width={50}
              height={50}
              src={author.fields.pfp.fields.file.url}
              alt={`Profile picture of ${author.fields.name}`}
            />
          )
        }
        <span class="holdtext">
          <div class="authtitle">
            {author?.fields?.name || "Unknown Author"}
          </div>
          <div class="authtitle2">{author?.fields?.role || "Contributor"}</div>
        </span>
      </div>
      <div class="authdesc">
        {author?.fields?.description || "No description available"}
      </div>
    </div>
  </div>
</div>

<News />

<Footer />

<style>
  h3 {
    color: var(--color) !important;
  }

  a:link {
    color: rgba(32, 213, 136, 1);
  }

  a:hover {
    color: rgb(22, 152, 96);
  }

  a:visited {
    color: rgb(32, 180, 213);
  }

  .auths {
    left: 50%;
    width: 95%;
    transform: translate(-50%, 0);
    padding-top: 30px;
    display: flex;
    flex-wrap: wrap;
    gap: 30px;
    position: relative;
    border-top: 2px solid var(--bg-opaque-1);
    z-index: 10000;
  }

  .titles {
    position: relative;
  }

  time {
    color: white;
  }

  .other {
    left: 5%;
    width: 50%;
    margin-top: 50px;
    font-family: Gilroy;
    font-size: 50px;
    position: relative;
  }

  .mainimg {
    -webkit-mask-image: url(/img/mask2.svg);
    mask-image: url(/img/mask2.svg);
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    mask-size: 100% 100%;
    mask-position: center;
    height: 180px;
    width: auto;
    filter: blur(0px);
    transform: translate(0, 10px);
    z-index: 10;
    position: relative;
  }

  .color {
    background: #0d6efd;
    background: AccentColor;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: brightness(150%);
  }

  .authtitle {
    font-family: Gilroy;
    font-size: 30px;
    position: relative;
    float: left;
    color: rgb(0, 0, 0);
  }

  .hold {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .holdtext {
    display: flex;
    flex-direction: row;
    gap: 16px;
  }

