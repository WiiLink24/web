---
import Layout from "../../../layouts/Layout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import HeadText from "../../../components/HeadText.astro";
import FormattedDate from "../../../components/FormattedDate.astro";
import "../../../styles/shared.css";
import { t, changeLanguage } from "i18next";
import { Icon } from "astro-icon/components";
import { contentfulClient } from "../../../lib/contentful";
import type { news } from "../../../lib/contentful";
import { documentToHtmlString } from "@contentful/rich-text-html-renderer";
import { extractTranscriptParticipantsFromHtml, type TranscriptParticipant } from "../../../lib/transcript";

changeLanguage("de");

type FormingLinksPost = {
    title: string;
    slug: string;
    date: string;
    image: any;
    unlist: boolean;
    description: string;
    content: any;
    author: any;
    authorPfpUrl?: string;
    transcriptParticipants: TranscriptParticipant[];
};
const entries = await contentfulClient.getEntries<news>({
    content_type: "newsPost"
});
let postsContentful: FormingLinksPost[] = entries.items.map(item => {
    const { title, slug, date, image, unlist, description, content, author } = item.fields;
    const transcriptParticipants = extractTranscriptParticipantsFromHtml(documentToHtmlString(content as any));
    const authorPfpUrl = (author as any)?.fields?.pfp?.fields?.file?.url;
    return {
        title,
        slug,
        date,
        image,
        unlist,
        description,
        content,
        author,
        authorPfpUrl,
        transcriptParticipants
    };
});
postsContentful.sort((a, b) => {
    return new Date(b.date).getTime() - new Date(a.date).getTime();
});
postsContentful = postsContentful.filter(post => post.unlist);
const vtName = (slug: string) => `news-post-${slug.replace(/[^a-zA-Z0-9-_]/g, "-")}`;
const sliceDescription = (description: string) => {
    return (description.split(" ").slice(0, 20).join(" ") +
        (description.split(" ").length > 20 ? "..." : ""));
};
---

<Layout
  title="News"
  description="Latest news from WiiLink."
  image="/img/News_embed.webp"
/>
<Header isGuide="display:none;" section="Forming Links" />
<div class="hold">
  <HeadText text="Links" />
  <div class="welcome-msg">
    <h2 style="font-size:40px; font-family:Gilroy;">Forming Links</h2>
    <h3 style="max-width: 800px; font-size: calc(1.3rem + .6vw);">
      Becca interviews the people behind the scenes of WiiLink, to give some
      insight into the project and the people who make it happen.
    </h3>
  </div>
  <div class="postholder">
    {
      postsContentful.map(post => (
        <div
          class="post"
          onclick={'window.location.href="/news/' + post.slug + '/";'}
          style={`background-color: var(--bg-opaque-1); border-radius: ${post.transcriptParticipants.length > 0 ? "28px 28px 28px 10px" : "8px"}; padding: 28px; cursor:pointer; transition: 0.2s; position:relative; overflow:visible; view-transition-name: ${vtName(post.slug)};`}>
          <a
            href={`/news/${post.slug}/`}
            aria-label={post.title + " Link"}
            style="text-decoration:none; color:var(--text-color); display:block; position:relative; z-index:1;">
            {post.transcriptParticipants.length == 0 && (
                          <div style="width:100%; display:flex; flex-direction:row; align-items:center; gap:8px; margin-bottom: 8px;">
              {post.authorPfpUrl && (
                <img
                  alt="News Author PFP"
                  class="authimage"
                  src={post.authorPfpUrl}
                />
              )}
              <div style="background: var(--border-color); border-radius:8px; padding:6px 12px; font-size:14px; display:flex; align-items:center; justify-content:center; font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;">
                <FormattedDate pre="" date={new Date(post.date)} />
              </div>
            </div>
            )}
            <b style="width:100%; font-size:28px; text-overflow: ellipsis; white-space: nowrap; overflow: hidden; text-align:left; position:relative;">
              {post.title}
            </b>
            {post.transcriptParticipants.length > 0 && (
              <div style="display:flex; flex-wrap:wrap; gap:8px; margin-top: 6px; margin-bottom: 12px;">
                {post.transcriptParticipants.map(participant => (
                  <div
                    style={`display:flex; align-items:center; gap:10px; padding:8px 12px; border-radius:${participant.role === "speaker" ? "999px 999px 999px 300px" : "999px 999px 300px 999px"}; background:${participant.role === "speaker" ? "var(--bg-color-secondary)" : "var(--bg-color-tertiary)"}; border:1px solid rgba(255,255,255,0.08);`}>
                    {participant.avatar ? (
                      <img
                        src={participant.avatar}
                        alt={participant.name}
                        style="width:32px; height:32px; border-radius:50%; object-fit:cover; border:2px solid rgba(255,255,255,0.14); flex:0 0 32px;"
                      />
                    ) : (
                      <div
                        aria-hidden="true"
                        style={`width:32px; height:32px; border-radius:50%; display:flex; align-items:center; justify-content:center; flex:0 0 32px; background:${participant.color}; color:white; font-family:Gilroy; font-size:12px; border:2px solid rgba(255,255,255,0.14);`}>
                        {participant.initials}
                      </div>
                    )}
                    <span style="display:flex; flex-direction:column; line-height:1.05;">
                      <b style="font-size:14px;">{participant.name}</b>
                    </span>
                  </div>
                ))}
              </div>
            )}
            <div
              class="descanim"
              style="margin-top: 8px; font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;">
              {sliceDescription(post.description)}
            </div>
          </a>
        </div>
      ))
    }
  </div>
  <h3
    style="margin-top:200px; font-size: calc(1.3rem + .6vw); text-align:center; position:relative; width:100%;">
    <b>Want to get <span class="color">WiiLink news</span> on your site or service? Just use our <span class="color">RSS feed</span>!</b>
  </h3>
  <a href="/rss.xml"
    ><buton
      class="btn center btn-success"
      style="left:50%; transform:translate(-50%, 0); margin-top:8px; z-index:1000; position:relative;">
      <Icon name="lucide:rss" style="margin-right:5px; margin-bottom:3px;" />
      {t("news.rssButton")}
    </buton></a
  >
</div>

<Footer />

<style>
  .hold {
    left: 50%;
    transform: translate(-50%, 0);
    width: calc(100% - 20px);
    max-width: 1500px;
    position: relative;
  }
  .authimage {
    width: 40px;
    height: 40px;
    border-radius: 8px;
  }

  .postholder {
    width: 100%;
    margin-bottom: 100px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
    position: absolute;
    gap: 13px;
    top: 45px;
    left: 50%;
    transform: translate(-50%, 0px);
    position: relative;
    z-index: 10;
  }

  .post {
    position: relative;
    width: 100%;
    border-radius: 8px;
    font-family: Gilroy;
    opacity: 1;
    hyphens: auto;
    transition: 0.2s;
  }

  .post:hover {
    transform: scale(1.02) !important;
    transition: 0.2s;
  }

  .post:hover {
    transform: translate(0, -10px);
    transition: 0.2s;
  }

  .postmini img {
    transition: 0.2s;
  }

  .postmini:hover img {
    filter: brightness(0.8) !important;
    transition: 0.2s;
  }

  .post:hover .heroImage {
    transform: scale(110%);
    filter: blur(2px) brightness(0.7);
    z-index: 0;
    transition: 0.3s;
  }

  @media only screen and (max-width: 1000px) {
    .postholder {
      width: 100%;
      left: 50%;
      transform: translate(-50%, 0);
      display: flex;
      flex-direction: column;
      gap: 18px;
      position: relative;
      z-index: 10;
    }

    .post:hover {
      transform: translate(0, 0px) scale(102%);
      box-shadow: 0px 0px 0px rgb(187, 187, 187);
      transition: 0.5s;
    }
  }

</style>
