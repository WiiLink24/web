---
import { changeLanguage } from "i18next";
import Layout from "../../../../layouts/Layout.astro";
import Header from "../../../../components/Header.astro";
import Footer from "../../../../components/Footer.astro";
import { Icon } from "astro-icon/components";
import "../../../../styles/shared.css";

changeLanguage("es");
---

<Layout title="Branding - WiiLink" description="WiiLink Extra content." image="/img/Extras_embed.png" />
<Header isGuide="display:none;" section="Branding" />


<style>
  body {
    font-family: Arial, sans-serif;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
  }


  div p {
    opacity:0.6;
  }

  .card img {
    border-radius:8px;
    margin-top:13px;
    width: 100%;
    display: block;
  }

  .card-title {
    text-align:left;
    font-weight: bold;
  }

  .card-action {
    margin-bottom:13px;
    cursor: pointer;
    border-radius:8px;
    position: relative;
    padding: 10px;
    background: var(--bg-color-tertiary);
    transition: 0.3s;
  }
</style>
</head>
<body>

  <div class="container">
    <h1 class="header" style="text-align:left;">
      <Icon name="palette" aria-hidden="true" style="margin-bottom:10px" /> Branding
    </h1><br />
  </div>

<div class="section">
  <div class="container">
    <div class="row">
      <div class="card">
        <img src="/img/logo-white.png" alt="Logo (Transparent)">
        <div class="card-content">
          <span class="card-title">Logo (Transparent)</span>
        </div>
        <div class="card-action">
          <a href="/img/logo-white.png">PNG</a>
          <a href="/img/logo-white.svg">SVG</a>
        </div>
      </div>
      <div class="card">
        <img src="/img/logo-color.png" alt="Logo (Color)">
        <div class="card-content">
          <span class="card-title">Logo (Color)</span>
        </div>
        <div class="card-action">
          <a href="/img/logo-color.png">PNG</a>
        </div>
      </div>
    </div>
  </div>
</div>

</body>
<Footer />
