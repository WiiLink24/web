---
import Layout from "../../../layouts/Layout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import HeadText from "../../../components/HeadText.astro";
import { t, changeLanguage } from "i18next";
import { Trans } from "astro-i18next/components";
import { localizePath } from "astro-i18next";
import { Icon } from "astro-icon/components";

changeLanguage("tr");

let goodies = await fetch(`https://wiilink.ca/json${localizePath("/goodies.json")}`).then((res) => res.json());
goodies = goodies.goodies.goodie;
---

<Layout
  title={t("extras.mainTitle")}
  description={t("extras.mainDesc")}
  image="/img/Extras_embed.webp"
/>
<Header isGuide="display:none;" section={t("header.extras")} />
  <div class="hold">
    <div class="welcome-msg">
      <HeadText text={t("header.extras")} />
      <h2 style="font-size:40px; font-family:Gilroy;">
        <Trans i18nKey="extras.title">
          This is <span
            class="badge bg-danger"
            style="top:-5px; left:0px; font-size:20px; font-family:Gilroy, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif; position:relative;"
          ></span><b style="font-family: Rubik;">WiiLink</b><span
            style="bottom:8px; text-transform: capitalize; color: #dc4914;"
            >extras</span
          >
        </Trans>
      </h2>
      <h3 style="font-size: calc(1.3rem + .6vw);">
        <Trans i18nKey="extras.subtitle">
          Here you'll find <b class="color">some really cool stuff</b> we've been
          working on. We hope you <b class="color">enjoy</b>!
        </Trans>
      </h3>
    </div>

    <div id="slide-track" class="postholder">
      {
        goodies.map((goodie, index) => (
          <div class="posthold">
            <a href={goodie.link}>
            <div class="post" style={`opacity:0; animation: fadeup 0.1s ${index * 50}ms linear forwards;`}>
                <div style="width:100%; bottom: 30px; right:30px; display:flex; flex-direction: column; align-items: flex-end; justify-content: right; position:absolute;">
                  <div class="title" set:html={goodie.title}></div>
                  <div class="desc">{goodie.desc}</div>
                </div>
              </a>
            </div>
          </div> ))
      }
    </div>

    <h3
      style="margin-top:100px; font-size: calc(1.3rem + .6vw); text-align:center; position:relative; width:100%;">
      <Trans i18nKey="extras.helpCall">
        <b
          >Do you think there's something we should <span class="color">add</span> in here?
          Be sure to <span class="color">get in touch</span>!</b
        >
      </Trans>
    </h3>
    <div class="btn-wrapper">
      <a href="mailto:support@wiilink.ca"
        ><div
          class="btn btn-success"
          style="color:white !important; padding:10px;">
          <Icon name="lucide:mail" style="margin-right:5px; margin-bottom:3px;" />
          {t("extras.contact")}
        </div></a
      >
      <a href="https://discord.gg/wiilink"
        ><div
          class="btn btn-primary"
          style="color:white !important; padding:10px;">
          <Icon name="discord" style="margin-right:5px; margin-bottom:3px;" />
          {t("extras.joinDiscord")}
        </div></a
      >
    </div>
    <div class="dots"></div>
  </div>
<Footer />

<style>
  .welcome-msg {
    top: 15px;
    width: 95%;
    max-width: 1500px;
    left: 50%;
    transform: translate(-50%, 0);
    margin-bottom: 30px;
    position: relative;
  }

  .btn-wrapper {
    width: 320px;
    top: 20px;
    left: 50%;
    transform: translate(-50%, 0);
    display: flex;
    gap: 10px;
    position: relative;
  }
  .dots {
    top: -50px;
    left: 53%;
    width: 150px;
    height: 150px;
    opacity: 0.5;
    background-image: radial-gradient(#00000040 2px, transparent 2px);
    background-size: 15px 15px;
    z-index: 0;
    position: relative;
  }

  html {
    font-family:
      systemui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      Roboto,
      Oxygen,
      Ubuntu,
      Cantarell,
      "Open Sans",
      "Helvetica Neue",
      sans-serif;
  }

  .color {
    background: url("/img/header_bg.webp");
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: brightness(150%);
  }

  .posthold {
    transform: translate(0, 0px);
    transition: 0.5s;
    position: relative;
  }

  .posthold:hover {
    transform: translate(0, -5px);
    transition: 0.5s;
  }

  .postholder {
    width: 98%;
    max-width: 1500px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
    position: absolute;
    gap: 20px;
    top: 40px;
    left: 50%;
    transform: translate(-50%, 0);
    position: relative;
    padding-bottom: 30px;
    z-index: 10;
  }

  .post {
    position: relative;
    background-color: var(--bg-color-secondary);
    height: 250px;
    width: 100%;
    border-radius: 18px;
    font-family: Gilroy;
    hyphens: auto;
    overflow: hidden;
    transition: 0.5s;
  }

  .post:hover {
    transform: translate(0, -20px) scale(105%);
    background-color: var(--bg-color-tertiary);
    transition: 0.5s;
  }

  .post:hover .heroImage {
    filter: blur(8px);
    rotate: -3deg;
    scale: 120%;
    z-index: 0;
    transition: 0.3s;
  }

  .title {
    width: 100%;
    z-index: 11;
    display: flex;
    align-items: center;
    flex-direction: row-reverse;
    gap: 8px;
    font-size: max(20px, 30px);
    margin-bottom: 8px !important;
    font-family: Gilroy;
  }

  .desc {
    font-family: systemui;
    width: 90%;
    font-size: 20px;
    text-align: right;
    transition: 0.5s;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  a {
    z-index: 1;
    color: white;
  }

  @keyframes fadeup {
    0% {
      opacity: 0;
      transform: translate(0, 20px);
    }
    100% {
      opacity: 1;
      transform: translate(0, 0px);
    }
  }

  @media only screen and (max-width: 1000px) {
    .postholder {
      width: 95%;
      left: 50%;
      transform: translate(-50%, 0);
      display: flex;
      flex-direction: column;
      flex-wrap: wrap;
      position: absolute;
      gap: 10px;
      top: 20px;
      padding-bottom: 0px;
      overflow: visible;
      position: relative;
      z-index: 10;
    }

    .post {
      margin-bottom: 0;
      height: 200px;
    }

    .post:hover {
      transform: scale(102%);
    }
  }

  @media only screen and (min-width: 2000px) {
    .hold {
      left: 50%;
      transform: translate(-50%, 150px);
      width: 1500px;
      margin-bottom: 80px;
      position: relative;
    }
  }


  .post {
    position: relative;
    height: 200px;
    width: 100%;
    background-color: var(--bg-color-secondary);
    border-radius: 18px;
    font-family: Gilroy;
    display: inline-block;
    hyphens: auto;
    overflow: hidden;
    transition: 0.5s;
  }

  .post:hover .title {
    color: var(--color) !important;
  }

  .post:hover .desc {
    color: var(--color) !important;
  }

  .post:hover {
    transition: 0.5s;
  }

  .post:hover .heroImage {
    filter: blur(8px);
    scale: 110%;
    opacity: 1;
    z-index: 10;
    transition: 0.3s;
  }

  .title {
    width: auto;
    z-index: 11;
    font-size: max(20px, 30px);
    text-align: right;
    margin-bottom: 15px;
    margin-left: 40px;
    line-height: 30px;
    font-family: Gilroy;
    transition: 0.5s;
  }

  .desc {
    font-family: inter;
    font-size: 20px;
    text-align: right;
    transition: 0.5s;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
    position: relative;
  }
</style>

<style is:global>
  .title {
    color: black;
  }

  .desc {
    color: black;
  }

  .image {
   display: inline-block;
   width: 32px;
   height: 32px;
   margin-bottom: -3px;
   background-color: currentColor;
   --svg: url('/icons/image.svg');
   -webkit-mask-image: var(--svg);
   mask-image: var(--svg);
   -webkit-mask-repeat: no-repeat;
   mask-repeat: no-repeat;
   -webkit-mask-size: 100% 100%;
   mask-size: 100% 100%;
  }

  .chart-no-axes-column {
   display: inline-block;
   width: 32px;
   height: 32px;
   margin-bottom: -3px;
   background-color: currentColor;
   --svg: url('/icons/chart-no-axes-column.svg');
   -webkit-mask-image: var(--svg);
   mask-image: var(--svg);
   -webkit-mask-repeat: no-repeat;
   mask-repeat: no-repeat;
   -webkit-mask-size: 100% 100%;
   mask-size: 100% 100%;
  }

  .wifi {
   display: inline-block;
   width: 32px;
   height: 32px;
   margin-bottom: -3px;
   background-color: currentColor;
   --svg: url('/icons/wifi.svg');
   -webkit-mask-image: var(--svg);
   mask-image: var(--svg);
   -webkit-mask-repeat: no-repeat;
   mask-repeat: no-repeat;
   -webkit-mask-size: 100% 100%;
   mask-size: 100% 100%;
  }

  .user {
   display: inline-block;
   width: 32px;
   height: 32px;
   margin-bottom: -3px;
   background-color: currentColor;
   --svg: url('/icons/user.svg');
   -webkit-mask-image: var(--svg);
   mask-image: var(--svg);
   -webkit-mask-repeat: no-repeat;
   mask-repeat: no-repeat;
   -webkit-mask-size: 100% 100%;
   mask-size: 100% 100%;
  }

  .rc24 {
   display: inline-block;
   width: 32px;
   height: 32px;
   margin-bottom: -3px;
   background-color: currentColor;
   --svg: url('/icons/rc24.svg');
   -webkit-mask-image: var(--svg);
   mask-image: var(--svg);
   -webkit-mask-repeat: no-repeat;
   mask-repeat: no-repeat;
   -webkit-mask-size: 100% 100%;
   mask-size: 100% 100%;
  }
</style>
