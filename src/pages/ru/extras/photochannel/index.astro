---
import { changeLanguage } from "i18next";
import Layout from "../../../../layouts/Layout.astro";
import Header from "../../../../components/Header.astro";
import Footer from "../../../../components/Footer.astro";
import { Icon } from "astro-icon/components";
import "../../../../styles/shared.css";

changeLanguage("ru");
---

<Layout title="Photo Channel Puzzle Cheats - WiiLink" description="WiiLink Extra content." image="/img/Extras_embed.png" />
<Header isGuide="display:none;" section="Photo Channel Puzzle Cheats" />
<style>
   body {
    font-family: Arial, sans-serif;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  h5 {
    opacity:0.7;
    font-weight:400;
  }

  h3, p {
    margin:0;
  }


  div p {
    opacity:0.6;
  }

  .card img {
    border-radius:8px;
    margin-top:13px;
    width: 100%;
    display: block;
  }

  .card-title {
    text-align:left;
    font-weight: bold;
  }

  .btn {
    display: inline-block;
    padding: 10px 20px;
    margin-top: 20px;
    text-align: center;
    color: white;
    background-color: #28a745;
    border-radius: 4px;
    text-decoration: none;
  }

  .btn i {
    margin-right: 5px;
  }
</style>
</head>
<body>

<div class="section no-pad-bot">
  <div class="container">
    <h1 class="header">
      <Icon name="download" aria-hidden="true" style="margin-bottom:10px;" /> Photo Channel Puzzle Cheats
    </h1>
    <div class="row">
      <h5 class="header col s12">
        These are intended to help get fast puzzle records on the Photo Channel, every number on the puzzle piece corresponds to where it fits.
      </h5>
      <a href="/extras/photochannel/puzzle_all.zip" id="download-button" class="btn">
        <Icon name="download" style="margin-bottom:3px;" /> Download Puzzle Cheats
      </a>
    </div>
  </div>
</div>

<div class="section">
  <div class="container">
    <br />
    <div class="row">
      <div class="card">
        <img src="/extras/photochannel/puzzle_6.jpg" alt="6-Piece Puzzle">
        <div class="card-content">
          <span class="card-title">6-Piece Puzzle</span>
        </div>
      </div>
      <div class="card">
        <img src="/extras/photochannel/puzzle_12.jpg" alt="12-Piece Puzzle">
        <div class="card-content">
          <span class="card-title">12-Piece Puzzle</span>
        </div>
      </div>
      <div class="card">
        <img src="/extras/photochannel/puzzle_24.jpg" alt="24-Piece Puzzle">
        <div class="card-content">
          <span class="card-title">24-Piece Puzzle</span>
        </div>
      </div>
    </div>
    <br>
    <div class="row">
      <div class="card">
        <img src="/extras/photochannel/puzzle_48.jpg" alt="48-Piece Puzzle">
        <div class="card-content">
          <span class="card-title">48-Piece Puzzle</span>
        </div>
      </div>
      <div class="card">
        <img src="/extras/photochannel/puzzle_192.jpg" alt="192-Piece Puzzle">
        <div class="card-content">
          <span class="card-title">192-Piece Puzzle</span>
          <p class="light">
            To access the 192 piece puzzle, on the puzzle select screen hold down the 1 Button to get the option. You can also use this trick on the puzzle records when you've successfully completed a 192 piece puzzle.
          </p>
        </div>
      </div>
    </div>
    <br />
  </div>
</div>

</body>

<Footer />